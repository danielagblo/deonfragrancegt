# ==========================================
# RABBI AZANDUNA - SERVER & FRONTEND ENVIRONMENT
# ==========================================

# Backend API Endpoint URL
# Leave unset to use this Astro app's own /api routes (recommended).
# Only set this if API requests should go to a separate backend.
# PUBLIC_API_URL=http://localhost:8085

# MySQL database configuration (required).
# The app no longer has fallback credentials, so all four values must be set.
DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASS=your-mysql-password
DB_NAME=your-database-name
DB_PORT=3306
# Set to true only if your host requires TLS.
DB_SSL=false

# Paystack server-side secret key.
# Required for payments; checkout and verification fail if it is missing.
# Used by /api/payments/initialize and /api/payments/verify/[reference].
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Paystack dashboard webhook URL to configure:
# https://your-domain.com/api/payments/webhook

# Optional: currently unused by the active Astro app.
# Only needed if you later add Paystack inline JS on the client.
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Inbox for the contact form
CONTACT_TO_EMAIL=edmundamonoo@gmail.com
