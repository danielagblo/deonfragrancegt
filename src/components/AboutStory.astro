---
import { BookOpen, Award, Landmark } from 'lucide-react';
import { HOMEPAGE_IMAGE_DEFAULTS } from '../lib/homepage';

interface Props {
  storyImage?: string;
  philosophyImage?: string;
}

const {
  storyImage = HOMEPAGE_IMAGE_DEFAULTS.story,
  philosophyImage = HOMEPAGE_IMAGE_DEFAULTS.philosophy,
} = Astro.props;
---

<div class="pt-2 pb-8 sm:pb-12 px-3.5 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-white font-['Poppins',sans-serif]">
  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
    <h2 class="font-['Cormorant_Garamond',serif] text-4xl sm:text-6xl font-medium text-[#1C140C] uppercase tracking-[0.08em] mb-3 sm:mb-4">
      Dion Fragrance
    </h2>
    <div class="w-16 h-1 bg-[#D4AF37] mx-auto mb-4 sm:mb-5"></div>
    <p class="text-[#1C140C]/75 text-xs sm:text-base font-normal leading-relaxed">
      A luxury Ghanaian perfume house dedicated to the art of sacred olfaction.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-14 items-center mb-12 sm:mb-16">
    <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 shadow-md">
      <img
        src={storyImage}
        alt="Artisanal perfume distillation"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="space-y-4">
      <span class="text-xs font-bold uppercase tracking-wider text-[#1C140C]">Our House</span>
      <h2 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-3xl font-bold text-[#1C140C] uppercase">
        Sacred Olfaction
      </h2>
      <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light">
        Dion Fragrance is a luxury perfume house in Ghana. Each extrait is composed with care, from bright citrus and soft florals to warm woods and creamy sweetness.
      </p>
      <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light">
        The collection is made to feel personal and refined, whether it is worn through a working day or kept for an evening out.
      </p>
      <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light">
        Every creation is formulated as a living testament: a blend of rare natural botanicals, precious resins, and pure aromatics crafted to elevate the everyday wearing of scent into a deeply meaningful personal ritual.
      </p>
    </div>
  </div>

  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
    <span class="text-xs font-bold uppercase tracking-wider text-[#1C140C]">Our Brand Philosophy</span>
    <h2 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-4xl font-bold text-[#1C140C] uppercase tracking-[0.03em] mt-3 mb-3">
      Sacred Wisdom, Bottled
    </h2>
    <div class="w-12 h-1 bg-[#D4AF37] mx-auto"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-14 items-center mb-12 sm:mb-16">
    <div class="space-y-4 order-2 md:order-1">
      <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light">
        We believe that fragrance is more than an aesthetic adornment—it is an invisible bridge between the sensory and the divine. From the frankincense and myrrh of ancient altars to the restorative balsams and exotic spices mentioned throughout sacred scripture, scent has always served as a vehicle for memory, prayer, and devotion.
      </p>
      <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light">
        We draw directly from biblical doctrines, historical figures, and timeless philosophies to compose scents with soul and purpose.
      </p>
    </div>

    <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 shadow-md order-1 md:order-2">
      <img
        src={philosophyImage}
        alt="Luxury perfume bottles"
        class="w-full h-full object-cover"
      />
    </div>
  </div>

  <div class="bg-neutral-50 border border-neutral-200/80 rounded-2xl p-4 sm:p-10 mb-12 sm:mb-16 shadow-xs">
    <span class="text-xs font-bold uppercase tracking-wider text-[#1C140C]">Intentional Craft</span>
    <h2 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-3xl font-bold text-[#1C140C] uppercase tracking-[0.03em] mt-2 mb-2">
      The Artistry of Intentional Craft
    </h2>
    <div class="w-12 h-1 bg-[#D4AF37] mb-4"></div>
    <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light max-w-3xl mb-6">
      As an independent, family-led house, we honor the deliberate patience of traditional perfumery. Our formulations are built with uncompromising attention to balance, structure, and depth.
    </p>
    <div class="space-y-3 text-xs sm:text-sm text-[#1C140C]">
      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37] mt-1.5 shrink-0"></span>
        <span><strong>Sacred Raw Materials:</strong> We source fine resins, woods, floral absolutes, and spices, pairing traditional biblical aromatics with high-grade modern accord design.</span>
      </div>
      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37] mt-1.5 shrink-0"></span>
        <span><strong>Maceration & Patience:</strong> Every batch undergoes a dedicated aging process, allowing raw materials to bind naturally into seamless, long-lasting compositions.</span>
      </div>
      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37] mt-1.5 shrink-0"></span>
        <span><strong>Artisanal Integrity:</strong> Being family-owned allows us total creative freedom, ensuring that every bottle leaving our atelier remains true to our vision and values.</span>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
    <span class="text-xs font-bold uppercase tracking-wider text-[#1C140C]">Home & Anchor</span>
    <h2 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-3xl font-bold text-[#1C140C] uppercase tracking-[0.03em] mt-3 mb-4">
      A Ghanaian Legacy of Luxury
    </h2>
    <p class="text-xs sm:text-sm text-[#1C140C]/80 leading-relaxed font-light">
      Ghana serves as both our home and our anchor. We take pride in representing African luxury on a global stage—demonstrating that world-class, intellectually grounded, and spiritually rich haute parfumerie thrives right here at home. We merge the warmth, dignity, and heritage of our Ghanaian roots with universal spiritual truths to create fragrances that resonate across borders.
    </p>
  </div>

  <div class="text-center mb-8">
    <span class="text-xs font-bold uppercase tracking-wider text-[#1C140C]">Core Pillars</span>
    <h2 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-3xl font-bold text-[#1C140C] uppercase tracking-[0.03em] mt-3">
      What Guides the House
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
    <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
      <div class="w-12 h-12 rounded-full bg-[#e7eef6] text-[#1C140C] flex items-center justify-center mx-auto mb-4">
        <BookOpen size={24} />
      </div>
      <h3 class="font-['Cormorant_Garamond',serif] text-lg font-bold text-[#1C140C] uppercase mb-1">
        Reverence
      </h3>
      <p class="text-xs text-[#1C140C]/75 font-light">
        Honoring biblical heritage and the profound history of sacred aromatics.
      </p>
    </div>

    <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
      <div class="w-12 h-12 rounded-full bg-[#e7eef6] text-[#1C140C] flex items-center justify-center mx-auto mb-4">
        <Award size={24} />
      </div>
      <h3 class="font-['Cormorant_Garamond',serif] text-lg font-bold text-[#1C140C] uppercase mb-1">
        Excellence
      </h3>
      <p class="text-xs text-[#1C140C]/75 font-light">
        Constructing rich, multi-layered formulas built to high-performance standards.
      </p>
    </div>

    <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl text-center">
      <div class="w-12 h-12 rounded-full bg-[#e7eef6] text-[#1C140C] flex items-center justify-center mx-auto mb-4">
        <Landmark size={24} />
      </div>
      <h3 class="font-['Cormorant_Garamond',serif] text-lg font-bold text-[#1C140C] uppercase mb-1">
        Heritage
      </h3>
      <p class="text-xs text-[#1C140C]/75 font-light">
        Remaining anchored as a proud Ghanaian family business driven by purpose and legacy.
      </p>
    </div>
  </div>

  <div class="text-center py-10 border-t border-gray-200">
    <h3 class="font-['Cormorant_Garamond',serif] text-2xl font-bold text-[#1C140C] uppercase mb-3">
      Discover Your Signature Scent
    </h3>
    <p class="text-xs text-[#1C140C]/75 mb-6">Explore our curated collections of fine fragrances and discovery sets.</p>
    <a
      href="/collections"
      class="inline-block px-8 py-3.5 bg-[#D4AF37] hover:bg-[#C49B2A] text-[#1C140C] font-bold text-xs uppercase tracking-widest rounded-lg transition-colors cursor-pointer"
    >
      Explore The Collections
    </a>
  </div>
</div>
