---
import Layout from '../layouts/Layout.astro';
import AboutStory from '../components/AboutStory.astro';
import { HeroCarousel } from '../components/HeroCarousel';
import { getHomepageImages } from '../lib/db';
import { HOMEPAGE_IMAGE_DEFAULTS, type HomepageImages } from '../lib/homepage';

let homeImages: HomepageImages = { ...HOMEPAGE_IMAGE_DEFAULTS };

try {
  homeImages = await getHomepageImages();
} catch (e) {
  console.error('Error fetching homepage images:', e);
}

---

<Layout title="Dion Fragrance">
  <HeroCarousel client:load />

  <section class="pt-10 sm:pt-14 pb-4 px-3.5 sm:px-6 lg:px-8 max-w-5xl mx-auto font-['Poppins',sans-serif]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14 items-center">
      <div class="mx-auto w-full max-w-xs aspect-[35/45] rounded-2xl overflow-hidden bg-white shadow-md">
        <img
          src="/profile.jpg"
          alt="Dion Fragrance profile"
          class="w-full h-full object-cover object-[center_20%]"
        />
      </div>
      <div class="text-center md:text-left">
        <span class="text-xs font-bold uppercase tracking-wider text-[#1C140C]">The House</span>
        <h1 class="font-['Cormorant_Garamond',serif] text-[1.7rem] sm:text-6xl font-medium text-[#1C140C] uppercase tracking-[0.04em] sm:tracking-[0.08em] leading-[0.95] mt-3">
          Dion Fragrance
        </h1>
        <div class="w-16 h-1 bg-[#D4AF37] mx-auto md:mx-0 mt-4 mb-5 sm:mb-6"></div>
        <div class="space-y-4 text-[#1C140C]/80 text-xs sm:text-base leading-relaxed">
          <p>
            Welcome to Dion Fragrance, a luxury perfume house in Ghana.
          </p>
          <p>
            Each bottle is an extrait de parfum, composed to feel clean, confident, and personal. From bright citrus to warm woods, the collection is made for everyday wear and evenings worth remembering.
          </p>
          <p class="text-[#1C140C] font-medium">
            Discover fragrances with soul, crafted for the extraordinary.
          </p>
        </div>
      </div>
    </div>
  </section>

  <AboutStory storyImage={homeImages.story} philosophyImage={homeImages.philosophy} />
</Layout>
