{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "astro"
    },
    "goserver": {
      "root": "archive/goserver",
      "runtime": "go",
      "entrypoint": "main.go"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
